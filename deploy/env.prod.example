# Copy to .env at the REPO ROOT (not deploy/) and fill in before running:
#   docker compose -f deploy/docker-compose.prod.yml up -d
#
# .env is gitignored. Nothing in this file should ever be committed filled in.

# ---------------------------------------------------------------- images --
# Pin a released tag. `latest` is deliberately not the default: a restart
# silently picking up a new build is how a "nothing changed" outage happens.
TRACELENS_IMAGE_TAG=v1.0.0
TRACELENS_IMAGE_REPO=satyamsipah/tracelens

# ------------------------------------------------------------ credentials --
TRACELENS_CLICKHOUSE_USER=tracelens
TRACELENS_CLICKHOUSE_PASSWORD=          # generate: openssl rand -base64 32
TRACELENS_GRAFANA_PASSWORD=             # generate: openssl rand -base64 24

# --------------------------------------------------------------- domains --
# Both must already point at this VPS before first start, or Caddy's
# Let's Encrypt challenge fails.
TRACELENS_WEB_DOMAIN=tracelens.example.com
TRACELENS_API_DOMAIN=api.tracelens.example.com
# What the BROWSER uses to reach the API (baked into the Next.js bundle).
TRACELENS_PUBLIC_API_URL=https://api.tracelens.example.com
TRACELENS_GRAFANA_ROOT_URL=http://localhost:3000

# ------------------------------------------------------------- resources --
# Sized for a 4-core / 8GB VPS. ClickHouse gets the largest share because
# it is doing the columnar work; the assembler's limit must stay above
# TRACELENS_BUFFER_MAX_BYTES with headroom for the decoder and writer queue.
TRACELENS_CLICKHOUSE_MEM=4g
TRACELENS_REDPANDA_MEM=1G
TRACELENS_REDPANDA_MEM_LIMIT=1500m
TRACELENS_ASSEMBLER_MEM=1g
TRACELENS_COLLECTOR_MEM=512m
TRACELENS_QUERY_MEM=512m
TRACELENS_WEB_MEM=512m
TRACELENS_PROMETHEUS_MEM=512m
TRACELENS_GRAFANA_MEM=512m

# ---------------------------------------------------------------- tuning --
TRACELENS_QUEUE_CAPACITY=8192
TRACELENS_BUFFER_MAX_TRACES=50000
TRACELENS_BUFFER_MAX_BYTES=268435456
TRACELENS_QUERY_MAX_ROWS_SCANNED=50000000
TRACELENS_LOG_LEVEL=info

# ------------------------------------------------------------------ demo --
# Only used with `--profile demo`.
TRACELENS_DEMO_RPS=5
